---
// 右下角滚动导航 —— 两种形态：
//   默认：上 / 中键 / 下 三个按钮
//   拟物化（设置里打开「滚动导航拟物化」）：换成 sakura 主题的卷轴 to-top
// 拟物化样式与素材取自 vitepress-theme-sakura（.vitepress/theme/ToTop.vue）
import Icon from './Icon.astro';
import { abs } from '../config';
---

<div class="Goingto">
  <div class="top"><Icon name="arrow-up" /></div>
  <div class="middle" title="中键：自动翻页" aria-label="Auto paginate">
    <img src={abs('/images/cursor/ocr_rdrvert.png')} alt="" draggable="false" />
  </div>
  <div class="bottom"><Icon name="arrow-down" /></div>
</div>

{/* 拟物化卷轴：默认藏在屏外 top:-900px，滚过 200px 后由脚本推到可见位置 */}
<a
  href="#"
  class="totop"
  style="top: -900px;"
  aria-label="to-top"
  data-skeuo-totop
></a>

<style lang="scss">

  .Goingto {
    z-index: 960; // 原 zIndex(40)
    position: fixed;
    right: 0;
    bottom: 0;
    width: $headerHeight;
    // 三个按钮竖排贴底
    height: $headerHeight * 2.5;
    user-select: none;
    transition: transform 0.6s;

    @media (max-width: $smallestWidth) {
      transform: translate3d(#{$headerHeight}, 0, 0);
    }
  }

  .top,
  .middle,
  .bottom {
    width: $headerHeight * 0.5;
    height: $headerHeight * 0.5;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--bg);
    border-radius: $borderRadius;
    cursor: pointer;
    transition: background 0.6s, color 0.6s;

    &:hover {
      color: var(--underline);
    }
  }

  .top {
    margin-top: auto;
  }

  .bottom {
    margin-bottom: $gap * 0.25;
  }

  .middle {
    margin: $gap * 0.25 auto;

    img {
      width: 1rem;
      height: 1rem;
      image-rendering: pixelated;
      pointer-events: none;
    }
  }

  // 素材是黑色像素图，深色皮肤下反相才看得见
  :global(html.skin-night) .middle img {
    filter: invert(1);
  }

  /* ---------- 拟物化卷轴（照搬 sakura 的 .totop） ---------- */
  // 两种形态互斥：开关关 → 三按钮；开关开 → 卷轴
  html.skeuo-top .Goingto {
    display: none;
  }
  html:not(.skeuo-top) .totop {
    display: none;
  }

  .totop {
    position: fixed;
    width: 70px;
    height: 900px;
    right: 25px;
    bottom: auto;
    z-index: 960;
    background-image: url('/images/sakura/scroll.png');
    background-size: 70px 900px;
    background-repeat: no-repeat;
    transition: top 0.5s ease-in-out;
    animation: skeuo-float 2s ease-in-out infinite;
    cursor: pointer;
    pointer-events: auto;

    &::before {
      display: none; // 去掉全局 a::before 的下划线
    }

    &:hover {
      filter: brightness(1.06);
    }
  }

  @keyframes skeuo-float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>

<script>
  /* ---------- 三按钮形态 ---------- */
  const box = document.querySelector<HTMLElement>('.Goingto .middle');
  box?.addEventListener('mousedown', (e) => {
    if (e.button !== 1) return; // 只认中键
    e.preventDefault();
    const doc = document.scrollingElement || document.documentElement;
    const atBottom = doc.scrollTop + window.innerHeight >= doc.scrollHeight - 2;
    window.scrollTo({
      top: atBottom ? 0 : doc.scrollTop + window.innerHeight * 0.9,
      behavior: 'smooth',
    });
  });
  box?.addEventListener('auxclick', (e) => {
    if (e.button === 1) e.preventDefault();
  });

  /* ---------- 拟物化卷轴形态 ----------
     逻辑照搬 sakura 的 ToTop.vue：滚过 200px 才把卷轴从屏外推上来，
     桌面推到 innerHeight-968（900px 高的卷轴正好露在视口下沿），
     窄屏只露 -640px 的一小截；点击平滑回顶。 */
  const totop = document.querySelector<HTMLElement>('[data-skeuo-totop]');
  if (totop) {
    const HIDE = 'top: -900px';
    const place = () => {
      if (window.scrollY > 200) {
        totop.style.top = window.innerWidth > 720 ? `${Math.min(window.innerHeight - 968, 0)}px` : '-640px';
      } else {
        totop.style.top = HIDE;
      }
    };
    totop.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    window.addEventListener('scroll', place, { passive: true });
    window.addEventListener('resize', place);
    place();
  }
</script>