---
// 右下角滚动导航 —— 两种形态：
//   默认：上 / 中键 / 下 三个按钮
//   拟物化（设置里打开「滚动导航拟物化」）：换成一根 900px 高的鸟居柱 to-top
// 位置与显隐逻辑参考 vitepress-theme-sakura 的 ToTop.vue（见 reference/），
// 但鸟居本身是用 CSS 画的，不再使用上游那张 scroll.png——
// 上游没有 LICENSE，那张二进制素材不适合直接再分发。
import Icon from './Icon.astro';
import { abs } from '../config';
---

<div class="Goingto">
  <div class="top"><Icon name="arrow-up" /></div>
  <div class="middle" title="中键：自动翻页" aria-label="Auto paginate">
    <img src={abs('/images/cursor/ocr_rdrvert.png')} alt="" draggable="false" />
  </div>
  <div class="bottom"><Icon name="arrow-down" /></div>
</div>

{/* 拟物化鸟居：默认藏在屏外 top:-900px，滚过 200px 后由脚本推到可见位置。
    柱身是 .totop 的 ::before，门身是下面这组纯装饰的子元素。 */}
<a
  href="#"
  class="totop"
  style="top: -900px;"
  aria-label="to-top"
  data-skeuo-totop
>
  <span class="gate" aria-hidden="true">
    <i class="pole"></i>
    <i class="beam"></i>
    <i class="tip-l"></i>
    <i class="tip-r"></i>
    <i class="marks"></i>
    <i class="posts"></i>
    <i class="nuki"></i>
    <i class="base"></i>
    <i class="curl"></i>
  </span>
</a>

<style lang="scss">

  .Goingto {
    z-index: 960; // 原 zIndex(40)
    position: fixed;
    right: 0;
    bottom: 0;
    width: $headerHeight;
    // 三个按钮竖排贴底
    height: $headerHeight * 2.5;
    user-select: none;
    transition: transform 0.6s;

    @media (max-width: $smallestWidth) {
      transform: translate3d(#{$headerHeight}, 0, 0);
    }
  }

  .top,
  .middle,
  .bottom {
    width: $headerHeight * 0.5;
    height: $headerHeight * 0.5;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--bg);
    border-radius: $borderRadius;
    cursor: pointer;
    transition: background 0.6s, color 0.6s;

    &:hover {
      color: var(--underline);
    }
  }

  .top {
    margin-top: auto;
  }

  .bottom {
    margin-bottom: $gap * 0.25;
  }

  .middle {
    margin: $gap * 0.25 auto;

    img {
      width: 1rem;
      height: 1rem;
      image-rendering: pixelated;
      pointer-events: none;
    }
  }

  // 素材是黑色像素图，深色皮肤下反相才看得见
  :global(html.skin-night) .middle img {
    filter: invert(1);
  }

  /* ---------- 拟物化鸟居（位置/显隐逻辑参考 sakura 的 ToTop.vue） ----------
     图形是纯 CSS 画的：柱身在 .pole，门身在 .gate 里那几个 <i>。
     尺寸沿用上游的 70×900 与显隐判据（见文件末尾的脚本），所以行为完全一致。 */
  // 两种形态互斥：开关关 → 三按钮；开关开 → 鸟居
  html.skeuo-top .Goingto {
    display: none;
  }
  html:not(.skeuo-top) .totop {
    display: none;
  }

  .totop {
    // 上游那张图只有这几个颜色，先记成变量方便统一调整
    --sak: #be493e; // 柱身与横梁的红褐
    --sak-dk: #8c3329; // 斜纹里的暗部
    --ink: #060102; // 描边用的近黑
    --paper: #fff; // 门身白

    position: fixed;
    width: 70px;
    height: 900px;
    right: 25px;
    bottom: auto;
    z-index: 960;
    transition: top 0.5s ease-in-out;
    animation: skeuo-float 2s ease-in-out infinite;
    cursor: pointer;
    pointer-events: auto;

    // 全局 a::before / a::after 的下划线在这里不要
    &::before,
    &::after {
      display: none;
    }

    &:hover {
      filter: brightness(1.06);
    }
  }

  .gate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 102px;
  }

  // 所有门身零件共用的定位方式
  .gate > i {
    position: absolute;
    display: block;
  }

  /* 柱身：红褐与黑相间，8px 一个周期（7px 红 + 1px 黑），
     两侧各留 1px 黑边。用 repeating-linear-gradient 而不是一堆 div。 */
  .pole {
    left: 50%;
    // 门身贴在元素底部（top = 900 - 6 - 102 = 792px），
    // 柱身要一路顶到元素最上沿，所以相对门身是 -792px、高 792px。
    top: -792px;
    width: 4px;
    height: 792px;
    margin-left: -2px;
    box-sizing: border-box;
    border-left: 1px solid var(--ink, #060102);
    border-right: 1px solid var(--ink, #060102);
    background: repeating-linear-gradient(
      to bottom,
      var(--sak, #be493e) 0 7px,
      var(--ink, #060102) 7px 8px
    );
  }

  /* 上梁（笠木）：横贯全宽的六边形梁，两端各配一个向外上翘的尖角。
     尖角顶点朝外（左端顶点在左上、右端在右上），和梁叠起来就是翘头的笠木。 */
  .beam {
    left: 0;
    right: 0;
    top: 6px;
    height: 11px;
    background: var(--paper, #fff);
    clip-path: polygon(0 0, 100% 0, 100% 60%, 93% 100%, 7% 100%, 0 60%);
  }

  .tip-l,
  .tip-r {
    top: 0;
    width: 17px;
    height: 12px;
    background: var(--paper, #fff);
  }

  .tip-l {
    left: 0;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  .tip-r {
    right: 0;
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
  }

  // 梁面上那几道深色短竖线（原图里就有的装饰笔画）
  .marks {
    left: 52%;
    top: 9px;
    width: 14px;
    height: 8px;
    background: repeating-linear-gradient(to right, #5c5c5c 0 2px, transparent 2px 5px);
  }

  // 两根立柱：用一个元素画两条，中间是空的
  .posts {
    left: 14px;
    right: 14px;
    top: 19px;
    height: 58px;
    background: linear-gradient(
      to right,
      var(--paper, #fff) 0 7px,
      transparent 7px calc(100% - 7px),
      var(--paper, #fff) calc(100% - 7px) 100%
    );
  }

  // 下梁（貫）：红褐斜纹，比上梁窄
  .nuki {
    left: 20px;
    right: 20px;
    top: 46px;
    height: 14px;
    background: repeating-linear-gradient(
      45deg,
      var(--sak, #be493e) 0 3px,
      var(--sak-dk, #8c3329) 3px 6px
    );
  }

  // 基座：略微外扩的白色梯形
  .base {
    left: 5px;
    right: 5px;
    top: 78px;
    height: 13px;
    background: var(--paper, #fff);
    clip-path: polygon(4% 0, 96% 0, 100% 100%, 0 100%);
  }

  // 右下角那撮小卷曲
  .curl {
    right: 21px;
    top: 84px;
    width: 11px;
    height: 18px;
    background: var(--paper, #fff);
    border-radius: 0 0 60% 60% / 0 0 100% 100%;
  }

  // 墨线描边：四向 0 模糊 drop-shadow 勾出 alpha 形状的 1px 轮廓
  .beam,
  .base {
    filter: drop-shadow(1px 0 0 var(--ink, #060102)) drop-shadow(-1px 0 0 var(--ink, #060102))
      drop-shadow(0 1px 0 var(--ink, #060102)) drop-shadow(0 -1px 0 var(--ink, #060102));
  }

  @keyframes skeuo-float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>

<script>
  /* ---------- 三按钮形态 ---------- */
  const box = document.querySelector<HTMLElement>('.Goingto .middle');

  /* ---------- 自动滚动 ----------
     浏览器原生那个「空白处按中键」的自动滚动没有可编程入口（那是浏览器 UI 行为，
     派发合成事件触发不了），所以这里自己实现一套等效的：进入后光标换成自动滚动
     图标，页面按「光标离视口中线的偏移」持续滚，越偏越快；再点一次按钮 / 点任意
     处 / 滚轮 / Esc 都退出，和原生一致。 */
  const asHtml = document.documentElement;
  let asRaf = 0;
  let asY = 0;
  let asNudge = 0;
  let asPrevBehavior = '';

  const asStop = () => {
    if (!asHtml.classList.contains('autoscrolling')) return;
    cancelAnimationFrame(asRaf);
    asRaf = 0;
    asNudge = 0;
    asHtml.classList.remove('autoscrolling');
    asHtml.style.scrollBehavior = asPrevBehavior;
  };

  const asLoop = () => {
    // 越偏离视口中线滚得越快；回到中线附近就停住。
    // 上限 16px/帧（约 960px/s）——实测 22 时一屏多长的文章两秒就滚过去了，太窜
    const half = window.innerHeight / 2;
    const ratio = Math.max(-1, Math.min(1, (asY - half) / (half * 0.6)));
    let v = ratio * 16 + asNudge;
    if (Math.abs(v) < 0.6) v = 0;
    asNudge = 0;
    const doc = document.scrollingElement || asHtml;
    // 顶到头尾就停下，别在边界上原地抖
    if (doc.scrollTop + v <= 0 || doc.scrollTop + v >= doc.scrollHeight - window.innerHeight) v = 0;
    window.scrollTo(0, doc.scrollTop + v);
    asRaf = requestAnimationFrame(asLoop);
  };

  const asStart = () => {
    if (asHtml.classList.contains('autoscrolling')) return;
    asHtml.classList.add('autoscrolling');
    asY = window.innerHeight / 2;
    // 全局有 scroll-behavior: smooth，不改掉的话每帧 scrollTo 都会被平滑动画
    // 拖成慢动作，自动滚动直接变成龟速
    asPrevBehavior = asHtml.style.scrollBehavior;
    asHtml.style.scrollBehavior = 'auto';
    asRaf = requestAnimationFrame(asLoop);
  };

  box?.addEventListener('click', (e) => {
    e.preventDefault();
    asHtml.classList.contains('autoscrolling') ? asStop() : asStart();
  });
  box?.addEventListener('auxclick', (e) => {
    if (e.button === 1) e.preventDefault();
  });

  if (box) {
    document.addEventListener(
      'mousemove',
      (e) => {
        if (asHtml.classList.contains('autoscrolling')) asY = e.clientY;
      },
      { passive: true },
    );
    document.addEventListener('keydown', (e) => {
      if (!asHtml.classList.contains('autoscrolling')) return;
      if (e.key === 'Escape') {
        asStop();
        return;
      }
      const d = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      if (d) {
        e.preventDefault();
        asNudge = d * 45;
      }
    });
    // 任意处左键点一下或滚一下就退出；但点在按钮上要留给 click 去切换，
    // 否则 mousedown 先退出、click 又把自动滚动打开，点了等于没点
    document.addEventListener('mousedown', (e) => {
      if (e.button === 0 && !box.contains(e.target as Node)) asStop();
    });
    document.addEventListener('wheel', asStop, { passive: true });
  }

  /* ---------- 拟物化卷轴形态 ----------
     逻辑照搬 sakura 的 ToTop.vue：滚过 200px 才把卷轴从屏外推上来，
     桌面推到 innerHeight-968（900px 高的卷轴正好露在视口下沿），
     窄屏只露 -640px 的一小截；点击平滑回顶。 */
  const totop = document.querySelector<HTMLElement>('[data-skeuo-totop]');
  if (totop) {
    const HIDE = 'top: -900px';
    const place = () => {
      if (window.scrollY > 200) {
        totop.style.top = window.innerWidth > 720 ? `${Math.min(window.innerHeight - 968, 0)}px` : '-640px';
      } else {
        totop.style.top = HIDE;
      }
    };
    totop.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    window.addEventListener('scroll', place, { passive: true });
    window.addEventListener('resize', place);
    place();
  }
</script>