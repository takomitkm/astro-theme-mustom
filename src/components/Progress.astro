---
// 阅读进度条 —— 移植自 Hexo 版 .m-progress（pjax 换页时的顶部进度条）
// MPA 化：页面加载时步进，window load 后走满并淡出（对应原 SPA 换页手感的等价物）
---

<div class="Progress" id="mustom-progress">
  <div class="current"></div>
</div>

{/* 阅读进度细线：贴在顶栏下沿。文章页按滚动位置算，正文每 209 字算一分钟 */}
<div class="readbar" id="mustom-readbar"><div class="current"></div></div>

<style lang="scss">
  .Progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 0.6vmin; // 原 $progress_height
    background: var(--progress-back);
    z-index: 1000;
    user-select: none;
    pointer-events: none;
    transition: opacity 0.4s;

    .current {
      height: 100%;
      width: 0;
      background: var(--progress-front);
      transition: width 0.2s;
    }

    &.done {
      opacity: 0;
    }
  }

  // 阅读进度：细蓝线，压在顶栏正下方（顶栏 z-index 970，这条给 971 贴着它）
  .readbar {
    position: fixed;
    top: $headerHeight;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 971;
    user-select: none;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;

    &.on {
      opacity: 1;
    }

    .current {
      height: 100%;
      width: 0;
      background: #4a90d9;
      transition: width 0.15s linear;
    }
  }
</style>

<script>
  const wrap = document.getElementById('mustom-progress');
  const bar = wrap?.querySelector<HTMLElement>('.current');
  if (wrap && bar) {
    let cur = 8 + Math.random() * 10;
    bar.style.width = cur + '%';
    const timer = window.setInterval(() => {
      cur = Math.min(cur + Math.random() * 8, 82);
      bar.style.width = cur + '%';
    }, 200);
    let finished = false;
    const done = () => {
      if (finished) return;
      finished = true;
      window.clearInterval(timer);
      bar.style.width = '100%';
      window.setTimeout(() => wrap.classList.add('done'), 300);
    };
    if (document.readyState === 'complete') done();
    else window.addEventListener('load', done, { once: true });
    window.setTimeout(done, 8000); // 兜底：资源卡住也别一直挂着
  }

  /* ---------- 阅读进度细线 ----------
     只在文章页出现。进度取"正文起点 → 当前屏幕中线"占全文正文高度的比例；
     字数提示行里的 min2read（= wordcount / 每分钟字数）用来算出预计阅读时长，
     挂到细线的 title 上，顺带把那条公式用上。非文章页没有 .Article，直接不显示。 */
  const readbar = document.getElementById('mustom-readbar');
  const readFill = readbar?.querySelector<HTMLElement>('.current');
  const body = document.querySelector<HTMLElement>('.Article .markdown-body');
  if (readbar && readFill && body) {
    const hint = document.querySelector<HTMLElement>('.Article .post-hint');
    const min = Number(/(\d+)\s*(?:分钟|min)/.exec(hint?.textContent ?? '')?.[1] ?? '0');
    if (min > 0) readbar.title = `预计阅读 ${min} 分钟`;

    const update = () => {
      const start = body.getBoundingClientRect().top + window.scrollY;
      const full = Math.max(body.offsetHeight, 1);
      // 视口中线落在正文里的位置，换算成"已读百分比"
      const seen = window.scrollY + window.innerHeight * 0.5 - start;
      const pct = Math.min(100, Math.max(0, (seen / full) * 100));
      readbar.classList.toggle('on', pct > 0.5 && pct < 100);
      readFill.style.width = pct.toFixed(2) + '%';
    };

    // update() 只读几个布局值，开销极小，直接调即可。
    // 原先套了 requestAnimationFrame 节流，但标签页切到后台时 rAF 不触发，
    // 节流标志会永久卡在 true，进度条从此再也不动。
    const onScroll = () => update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.fonts?.ready.then(update);
    update();
  }
</script>
