---
// 顶栏 —— 对应 Header.vue + Hexo 版 xdrawer/xaside：
// 左侧抽屉总开关、门户、居中主菜单、搜索、右栏总开关（每侧一个折叠逻辑）
// 中列从原来的空占位换成居中菜单，样式参考 vitepress-theme-sakura 的 header
import Icon from './Icon.astro';
import T from './T.astro';
import { header, headerMenu } from '../config';
import { site } from '../config';
const withEn = site.languages.includes('en-US');
---

<div class="Header">
  <button type="button" class="ext xdrawer" data-collapse="drawer" aria-label="Toggle drawer">
    <Icon name="bars" />
  </button>
  {
    header.portal && (
      <button type="button" class="ext" data-ext="portal" aria-label="Portals">
        <Icon name="cube" />
      </button>
    )
  }
  {/* 居中主菜单（照搬 sakura 的 .container：绝对居中 + 图标 + 文字）。
      这一格是 grid 的 auto 列，左右各两格等宽的固定列，所以天然就是视口正中，
      不用再套一层 absolute。 */}
  <nav class="nav">
    <ul>
      {
        headerMenu.map((item) => (
          <li>
            <a href={item.link}>
              <span>
                <Icon name={item.icon} fw />
                <T zh={item.text['zh-CN']} en={withEn ? item.text['en-US'] : undefined} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    header.search && (
      <button type="button" class="ext" data-ext="search" aria-label="Search">
        <Icon name="search" />
      </button>
    )
  }
  <button type="button" class="ext xaside" data-collapse="aside" aria-label="Toggle aside">
    <Icon name="chevron-right" />
  </button>
</div>

<style lang="scss">
  .Header {
    z-index: 970; // 原 zIndex(30)
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: $headerHeight;
    color: var(--header);
    // 半透明（sakura 的 header 是 rgba(255,255,255,0.9)）。
    // 用 color-mix 从各皮肤的 --header-bg 推出来，三个皮肤自动都对；
    // 前一行是给不支持 color-mix 的旧浏览器兜底的不透明底色。
    background: var(--header-bg);
    background: color-mix(in srgb, var(--header-bg) 88%, transparent);
    box-shadow: 0 $borderRadius * -0.5 $borderRadius var(--header);
    display: grid;
    grid-template-columns: $headerHeight $headerHeight auto $headerHeight $headerHeight;
    grid-template-rows: $headerHeight;

    @media (max-width: $smallestWidth) {
      box-shadow: 0 0 1px var(--header);
    }
  }

  /* ---------- 居中主菜单 ---------- */
  .nav {
    height: $headerHeight;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      align-items: center;
    }

    li {
      // sakura 原版是 margin: 0 12px，这里按 rem 跟随根字号
      margin: 0 0.75rem;
      white-space: nowrap;
    }

    a {
      color: inherit;
      transition: color 0.2s ease-out;

      // 全局 a::before 的下划线在导航里太吵，去掉
      &::before {
        display: none;
      }

      &:hover {
        color: var(--underline);
      }

      > span {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      :global(svg) {
        font-size: 0.85em;
      }
    }

    // 窄屏塞不下四个带图标的按钮，退回纯文字
    @media (max-width: $smallestWidth) {
      li {
        margin: 0 0.4rem;
      }
      a > span :global(svg) {
        display: none;
      }
    }
  }

  .ext {
    transition: background 0.6s, color 0.6s;
  }

  .ext {
    height: $headerHeight;
    width: $headerHeight;
    line-height: $headerHeight;
    text-align: center;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    padding: 0;

    &:hover {
      background: var(--highlight);
      @media (max-width: $smallestWidth) {
        background: var(--header-bg);
      }
    }

    &.active[data-ext='portal'] {
      color: var(--readme-more-txt);
      background: var(--link);
    }
    &.active[data-ext='search'] {
      color: var(--readme-more-txt);
      background: var(--underline);
    }

    // 抽屉开关激活态：图标旋转 90°（原为右下角小圆点，按要求去掉）
    &.xdrawer :global(svg) {
      transition: transform 0.6s;
    }

    &.xdrawer.active :global(svg) {
      transform: rotate(90deg);
    }

    // 右栏开关激活态：箭头旋转 180°（Hexo 版 xaside 的指示）
    &.xaside :global(svg) {
      transition: transform 0.6s;
    }
    &.xaside.active :global(svg) {
      transform: rotate(180deg);
    }
  }
</style>
