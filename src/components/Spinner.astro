---
// 加载指示 —— 对应 Spinner.vue（MPA 适配：页面加载完成后淡出，代替原 SPA 路由切换时的转圈）
---

<div class="Spinner" id="mustom-spinner"></div>
<noscript>
  <style>
    #mustom-spinner {
      display: none;
    }
  </style>
</noscript>

<style lang="scss">

  .Spinner {
    z-index: 980; // 原 zIndex(20)
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: var(--spinner-bg);
    transition: opacity 0.2s;

    &::before {
      content: '';
      position: absolute;
      top: calc(50vh - #{$spinnerSize * 0.5});
      left: calc(50% - #{$spinnerSize * 0.5});
      width: $spinnerSize;
      height: $spinnerSize;
      border: $spinnerBorderSize solid var(--spinner);
      border-top: $spinnerBorderSize solid transparent;
      border-radius: 50%;
      animation: spin 1.2s linear infinite;
    }

    &.hide {
      pointer-events: none;
      opacity: 0;
    }
  }
</style>

<script>
  const el = document.getElementById('mustom-spinner');
  if (el) {
    const hide = () => window.setTimeout(() => el.classList.add('hide'), 200);
    if (document.readyState !== 'loading') hide();
    else document.addEventListener('DOMContentLoaded', hide);
  }
</script>
