---
// 标签/分类索引页的整页云图卡片（Panel 的页面版）
import Icon from './Icon.astro';
import T from './T.astro';
import { zhCN, enUS } from '../lib/locales';
import { site } from '../config';
import type { NameMapEntry } from '../lib/posts';

interface Props {
  mode: 'categories' | 'tags';
  entries: NameMapEntry[];
  total: number;
  max: number;
}

const { mode, entries, total, max } = Astro.props;
const withEn = site.languages.includes('en-US');

const normalize = (p: string) => {
  let s = decodeURIComponent(p);
  if (s.length > 1) s = s.replace(/\/+$/, '') || '/';
  return s;
};
const here = normalize(Astro.url.pathname);
---

<div class="Cloud card">
  <div class="caption">
    <span class="icon">
      <Icon name={mode === 'categories' ? 'folder-open' : 'tags'} fw />
    </span>
    <T
      zh={mode === 'categories' ? zhCN.panels.captions.categories : zhCN.panels.captions.tags}
      en={withEn ? (mode === 'categories' ? enUS.panels.captions.categories : enUS.panels.captions.tags) : undefined}
    />
  </div>
  <div class="inner">
    {
      entries.map((e) => (
        <a
          href={e.url}
          class:list={[{ active: here === normalize(e.url) }]}
          style={`font-size:${e.posts.length / total + 0.75}rem;opacity:${(e.posts.length / max) * 0.5 + 0.5}`}
        >
          {e.name}
        </a>
      ))
    }
  </div>
</div>

<style lang="scss">

  .inner {
    padding: 0.5rem 1rem 1.5rem;
    user-select: none;

    :global(a) {
      color: var(--txt);
      display: inline-block;
      margin: 0.75rem;

      &.active {
        color: var(--underline);
        opacity: 1 !important;
        &::before {
          width: 100%;
        }
      }
    }
  }
</style>
