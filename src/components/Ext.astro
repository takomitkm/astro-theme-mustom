---
// Ext 浮层 —— 对应 Ext.vue（portal 门户页 + search 搜索页）
// 显隐由 html.ext-portal / ext-search 控制（见 global.scss）
import Icon from './Icon.astro';
import { portals } from '../config';
---

<div class="Ext">
  <div class="portal">
    {
      portals.map((portal) =>
        portal.install ? (
          // PWA 安装卡：未捕获 beforeinstallprompt 时隐藏
          <button
            type="button"
            class="portal-item pwa-install"
            data-pwa-install
            hidden
            title={portal.name}
          >
            <div class="icon" style={`background-image:url('${portal.icon}')`} />
            <div class="info">
              <div class="name">{portal.name}</div>
              <div class="desc">{portal.desc}</div>
            </div>
          </button>
        ) : (
          <a target="_blank" href={portal.link} title={portal.name}>
            <div class="icon" style={`background-image:url('${portal.icon}')`} />
            <div class="info">
              <div class="name">{portal.name}</div>
              <div class="desc">{portal.desc}</div>
            </div>
          </a>
        ),
      )
    }
  </div>
  <div class="search">
    <div class="Search">
      <span class="input-icon"><Icon name="search" /></span>
      <input
        aria-label="Search"
        placeholder="Search / 搜索"
        autocomplete="off"
        spellcheck="false"
      />
      <ul class="suggestions"></ul>
    </div>
  </div>
</div>

<style lang="scss">

  .Ext {
    z-index: 969; // 原 zIndex(31)
    position: fixed;
    top: $headerHeight;
    left: 0;
    width: 100%;
    height: calc(100vh - #{$headerHeight});
    background: var(--bg);
    overflow-x: hidden;
    overflow-y: auto;
  }

  .portal,
  .search {
    padding: $headerHeight;

    @media (max-width: $smallestWidth) {
      padding: 1rem;
    }
  }

  .portal {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, calc((100% - 2rem) / 3));

    @media (max-width: $smallerWidth) {
      grid-template-columns: repeat(2, calc((100% - 1rem) / 2));
    }
    @media (max-width: $smallestWidth) {
      gap: 0.5rem;
      grid-template-columns: 100%;
      margin-bottom: $headerHeight;
    }

    > :global(a),
    > .portal-item {
      display: inline-block;
      width: 100%;
      height: 6rem;
      padding: 1rem;
      color: var(--txt);
      position: relative;
      border-radius: $borderRadius;
      background-color: var(--bg);
      transition: background 0.6s, box-shadow 0.6s;
      border: 0;
      cursor: pointer;
      text-align: left;
      font: inherit;

      &::before {
        display: none;
      }

      &:hover {
        box-shadow: 0 0 0 1px;
      }
    }

    > .portal-item[hidden] {
      display: none;
    }
  }

  .portal :global(.icon) {
    height: 4rem;
    width: 4rem;
    position: absolute;
    left: 1rem;
    top: 1rem;
    background-size: cover;
    border-radius: $borderRadius;
  }

  .portal :global(.info) {
    margin-left: 5rem;
  }

  .portal :global(.name),
  .portal :global(.desc) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 2rem;
  }

  .portal :global(.desc) {
    filter: invert(0.233);
  }

  /* ---------- 搜索框（parts/Search.vue）；建议列表由 TS 动态创建，需 :global 才能命中 ---------- */
  .Search {
    display: block;
    position: relative;
    width: 100%;

    input {
      cursor: text;
      width: 100%;
      // 输入框加高到与顶栏等高
      height: $headerHeight;
      color: var(--txt);
      display: block;
      border: 1px solid var(--highlight);
      box-shadow: 0 0 1px var(--txt);
      border-radius: $borderRadius;
      font-size: 0.9rem;
      line-height: $headerHeight;
      // 只留左侧放大镜位（右侧搜索按钮已删除）
      padding: 0 1rem 0 2.5rem;
      outline: none;
      transition: all 0.2s ease;
      background: var(--bg);

      &:focus {
        cursor: auto;
        border-color: var(--readme-more-bg);
      }
    }

    // 放大镜：与等高的 input 垂直居中（原来写死 2rem 会偏上）
    :global(.input-icon) {
      position: absolute;
      left: 0.9rem;
      top: 0;
      height: $headerHeight;
      display: flex;
      align-items: center;
      line-height: 1;
      pointer-events: none;
      color: var(--txt);
      opacity: 0.6;
    }

    // 结果列表改为常规流：随内容撑开、随 .Ext 滚动，不再绝对定位漂移
    :global(.suggestions) {
      border-radius: $borderRadius;
      list-style-type: none;
      width: 100%;
      margin-top: 1rem;
    }

    // pagefind 弹窗搜索的结果行 / 总数行 / emoji 提示行（Hexo fork search.js）
    :global(.message) {
      padding: 0.6em 0.6em;
      text-align: center;
      opacity: 0.7;

      small {
        display: block;
        margin-top: 0.3em;
        font-size: 0.85em;
        opacity: 0.8;
      }
    }

    :global(.count) {
      user-select: none;
      padding: 0.6em 2em 0.4em;
      text-align: right;
      font-size: 0.88em;
      opacity: 0.7;
    }

    // 预测输入：可点的补全词
    :global(.predictions) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }

    :global(.prediction) {
      padding: 0.2rem 0.6rem;
      font: inherit;
      font-size: 0.85em;
      line-height: 1.6;
      color: var(--txt);
      background: var(--highlight);
      border: none;
      border-radius: $borderRadius;
      cursor: pointer;

      &:hover {
        color: var(--bg);
        background: var(--readme-more-bg);
      }
    }

    :global(.result-item) {
      padding: 0.45em 0.6em;
      border-radius: $borderRadius;

      &:hover {
        background: var(--highlight);
      }

      a {
        display: inline-block;
        color: var(--readme-more-bg);
        font-size: 1.05em;
        font-weight: 600;

        &::before {
          display: none;
        }
      }

      p {
        margin-bottom: 0;
        font-size: 0.85em;
        line-height: 1.6;
        color: var(--txt);
      }

      mark,
      strong {
        background: none;
        color: var(--search-highlight);
        text-decoration: underline;
      }
    }

    :global(.suggestion) {
      line-height: 1.4;
      padding: 0.4rem 0.6rem;
      border-radius: $borderRadius;
      cursor: pointer;

      :global(a) {
        white-space: normal;
        color: var(--readme-more-bg);

        &::before {
          display: none;
        }
      }

      :global(.page-title) {
        font-weight: 600;
      }

      &.focused {
        background-color: var(--readme-more-bg);

        :global(a) {
          color: var(--readme-more-txt);
        }
      }
    }
  }
</style>

<script>
  import { initSearch } from '../lib/client/search';
  initSearch();

  // PWA 安装卡（自 Brand 行尾按钮迁入）：捕获 beforeinstallprompt 才显示
  interface BeforeInstallPromptEvent extends Event {
    prompt(): Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }

  const pwaBtns = document.querySelectorAll<HTMLButtonElement>('[data-pwa-install]');
  if (pwaBtns.length) {
    let deferred: BeforeInstallPromptEvent | null = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferred = e as BeforeInstallPromptEvent;
      pwaBtns.forEach((b) => (b.hidden = false));
    });
    pwaBtns.forEach((btn) =>
      btn.addEventListener('click', async () => {
        if (!deferred) return;
        await deferred.prompt();
        await deferred.userChoice;
        deferred = null;
        pwaBtns.forEach((b) => (b.hidden = true));
      }),
    );
    window.addEventListener('appinstalled', () => {
      deferred = null;
      pwaBtns.forEach((b) => (b.hidden = true));
    });
  }
</script>
