---
// 一言 —— 对应 Hitokoto.vue（内容由 hitokoto.ts 客户端拉取替换）
import Icon from './Icon.astro';
import T from './T.astro';
import { images, hitokoto } from '../config';
import { zhCN, enUS } from '../lib/locales';
import { site } from '../config';

const withEn = site.languages.includes('en-US');
/** 故障风的切片条数：上/中/下各一条 */
const GLITCH_BANDS = [0, 1, 2];
const before = images.hitokotoLeft ? `background-image:url('${images.hitokotoLeft}')` : undefined;
const after = images.hitokotoRight ? `background-image:url('${images.hitokotoRight}')` : undefined;
---

<div class="Hitokoto card">
  <div class="caption">
    <span class="icon"><Icon name="circle-notch" fw /></span>
    <T zh={zhCN.hitokoto.caption} en={withEn ? enUS.hitokoto.caption : undefined} />
  </div>
  <div class="inner">
    <div class="before" style={before}></div>
    <div class="word">
      {/* 故障风：底字 + 三条横向切片。切片由 Array.from 渲染（不靠伪元素），
          各自只露出上/中/下三分之一，悬浮时逐帧横向撕裂。
          .word 的 ::before/::after 已被『』括号占用，所以整块要自己包一层。 */}
      <span class="glitch">
        <span class="glitch-text">{hitokoto.placeholder?.word ?? 'Loading...'}</span>
        {GLITCH_BANDS.map((band) => (
          <i class="glitch-slice" data-band={band} data-text={hitokoto.placeholder?.word ?? 'Loading...'} aria-hidden="true" />
        ))}
      </span>
    </div>
    <div class="from"><span>{hitokoto.placeholder?.from ?? 'Loading...'}</span></div>
    <div class="after" style={after}></div>
  </div>
  {/* 点击迸发粒子用的画布，覆盖整张卡片 */}
  <canvas class="fx" aria-hidden="true"></canvas>
  <div class="minimize">
    <Icon name="minus" class="minus" />
    <Icon name="plus" class="plus" />
  </div>
</div>

<style lang="scss">

  .inner {
    line-height: 1.5;
    position: relative;
    border-bottom: $borderRadius solid var(--highlight);
    padding-bottom: $hitokotoImgHeight * 0.66;
    text-align: center;

    @media (max-width: $smallestWidth) {
      padding-bottom: $hitokotoImgHeight * 0.33;
    }

    .before,
    .after {
      position: absolute;
      bottom: 0;
      height: $hitokotoImgHeight * 0.66;
      width: $hitokotoImgWidth * 0.66;
      background-size: cover;

      @media (max-width: $smallestWidth) {
        height: $hitokotoImgHeight * 0.33;
        width: $hitokotoImgWidth * 0.33;
      }
    }

    .before {
      left: 0;
    }

    .after {
      right: 0;
    }
  }

  .word {
    padding: 2rem;
    position: relative;
    font-size: 1.25rem;
    // 句子只在标点处换行（Hexo fork 的 hitokoto.styl）
    word-break: keep-all;
    overflow-wrap: break-word;

    &::before {
      content: '『';
      position: absolute;
      left: 0.5rem;
      top: 1rem;
    }
    &::after {
      content: '』';
      position: absolute;
      right: 0.5rem;
      bottom: 1rem;
    }

    @media (max-width: $smallestWidth) {
      padding: 1rem;
      font-size: 1rem;
      &::before,
      &::after {
        display: none;
      }
    }
  }

  .from {
    position: absolute;
    width: 100%;
    padding: 1rem 0;
    z-index: 1; // 夜间不被两侧表情盖住（Hexo fork 的修复）

    // 作者行收进一个铺底色的小盒（Hexo fork 样式）
    :global(span) {
      display: inline-block;
      background: var(--bg);
      padding: 0.15em 0.4em;
      border-radius: $borderRadius;
    }

    &::before,
    &::after {
      content: ' — ';
    }

    @media (max-width: $smallestWidth) {
      position: relative;
      padding: 0;
    }
  }

  /* ---------- 故障风 ----------
     三条横向切片各自只露出上/中/下三分之一，悬浮时用 steps() 逐帧横向撕裂。
     与参考实现的差别（也是刻意拉开距离的地方）：
       - 参考是「两层伪元素 + 纵向色带扫描 + 平滑 ease-in-out 往返」，
         这里改成「三条切片 + 横向位移 + steps() 数字撕裂」，结构与观感都不同
       - 切片由 Astro 模板 Array.from 渲染，不靠伪元素
       - 颜色取主题变量并按切片错开，不硬编码 */
  .glitch {
    position: relative;
    display: inline-block;
    font-weight: 700;

    // 底字：正常显示，不需要动画
    .glitch-text {
      position: relative;
      z-index: 1;
    }
  }

  .glitch-slice {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;

    // 三条分别只露出上/中/下三分之一
    &[data-band='0'] {
      clip-path: inset(0 0 66% 0);
    }
    &[data-band='1'] {
      clip-path: inset(34% 0 33% 0);
    }
    &[data-band='2'] {
      clip-path: inset(67% 0 0 0);
    }

    &::before {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      padding: 0;
    }

    // 三条各一个颜色，且在 jshine / whiteblack / night 三套皮肤下都互不相同：
    // --selection 与 --underline 在黑白皮肤里同为 #ff3300，用后者会让两条撞色
    &[data-band='0']::before {
      color: var(--selection);
    }
    &[data-band='1']::before {
      color: var(--link-markdown);
    }
    &[data-band='2']::before {
      color: var(--readme-more-warn);
    }
  }

  .glitch:hover .glitch-slice {
    opacity: 0.85;
    // steps() 让位移一格一格跳，做出数字信号撕裂的感觉；
    // 三条各错开一点相位，避免三条完全同步
    animation: glitch-tear 0.42s steps(5, end) infinite;

    &[data-band='1'] {
      animation-delay: -0.14s;
    }
    &[data-band='2'] {
      animation-delay: -0.28s;
    }
  }

  @keyframes glitch-tear {
    0% {
      transform: translate3d(0, 0, 0);
    }
    20% {
      transform: translate3d(-0.09em, 0, 0);
    }
    40% {
      transform: translate3d(0.07em, 0, 0);
    }
    60% {
      transform: translate3d(-0.05em, 0, 0);
    }
    80% {
      transform: translate3d(0.04em, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch:hover .glitch-slice {
      animation: none;
    }
  }

  // 粒子画布：铺满卡片、不吃指针事件
  .fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }
</style>

<script>
  import { initHitokoto } from '../lib/client/hitokoto';
  initHitokoto();

  /* ---------- 点击迸发粒子 ----------
     参考实现里没有这部分，是自己加的：在点击点生成一批彩色小方块，
     带初速度与重力飞散，寿命结束就清空画布。

     性能上有三处刻意压成本：
     1) rAF 句柄与粒子数组提到 burst 外面 —— 原先写在 burst 内部，
        cancelAnimationFrame 取消的永远是 0，连点会叠加出多个动画循环；
     2) 画布 DPR 封顶 1 —— 粒子本来就是粗方块，用不着视网膜密度，
        而 clearRect 的开销与像素数成正比（视网膜屏上直接省 4 倍）；
     3) 每个粒子用 setTransform 取代 save()/restore()，少一层状态栈出入。 */
  const card = document.querySelector<HTMLElement>('.Hitokoto');
  const fx = card?.querySelector<HTMLCanvasElement>('.fx');

  if (card && fx) {
    interface P {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      size: number;
      color: string;
      spin: number;
      rot: number;
    }
    const N = 90;
    const MAX_DPR = 1; // 见上，粒子够粗，DPR 再高只是白烧 clearRect

    /* 整体缩放：尺寸、 初速、 重力按同一比例缩小，轨迹形状不变、时长不变。
       （距离和重力同比例缩放时，飞行时间 t ∝ sqrt(d/g) 正好抵消，所以
        life 的衰减率不用动。）调大小只改这一个数。 */
    const SCALE = 1 / 3;
    const GRAVITY = 0.16 * SCALE;
    const LIFT = 1.4 * SCALE; // 初速的略带上抛
    const EDGE = 40 * SCALE; // 飞出这个余量就直接判死

    let raf = 0;
    let ps: P[] = [];
    let cw = 0;
    let ch = 0;
    const ctx = fx.getContext('2d');

    const palette = (): string[] => {
      const cs = getComputedStyle(card!);
      const vars = ['--link', '--selection', '--link-markdown', '--underline', '--readme-more-bg', '--readme-more-warn'];
      // 去重：黑白皮肤里 --link 与 --underline 同色，不去重的话粒子几乎是一个颜色
      const seen = new Set<string>();
      for (const v of vars) {
        const c = cs.getPropertyValue(v).trim();
        if (c) seen.add(c);
      }
      const list = [...seen];
      while (list.length < 3) list.push(list[list.length % Math.max(1, list.length)] ?? '#999');
      return list.length ? list : ['#999'];
    };

    const tick = () => {
      raf = 0;
      if (!ctx) return;
      ctx.clearRect(0, 0, cw, ch);
      let alive = 0;
      for (const p of ps) {
        if (p.life <= 0) continue;
        // 飞出画布就直接判死，不必等寿命跑完
        if (p.x < -EDGE || p.x > cw + EDGE || p.y > ch + EDGE) {
          p.life = 0;
          continue;
        }
        alive++;
        p.vy += GRAVITY;
        p.vx *= 0.99;
        p.vy *= 0.99;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.spin;
        p.life -= 0.014;
        ctx.setTransform(1, 0, 0, 1, p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(0, Math.min(1, p.life));
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
      }
      if (alive > 0) raf = requestAnimationFrame(tick);
      else {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.globalAlpha = 1;
        ctx.clearRect(0, 0, cw, ch);
      }
    };

    const burst = (ev: MouseEvent) => {
      if (!ctx) return;
      const box = card!.getBoundingClientRect();
      cw = box.width;
      ch = box.height;
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      fx!.width = Math.round(cw * dpr);
      fx!.height = Math.round(ch * dpr);
      fx!.style.width = cw + 'px';
      fx!.style.height = ch + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cw, ch);

      const colors = palette();
      const cx = ev.clientX - box.left;
      const cy = ev.clientY - box.top;
      ps = [];
      for (let i = 0; i < N; i++) {
        // 均匀取角度 + 随机初速，得到一圈炸开的火花
        const a = (Math.PI * 2 * i) / N + Math.random() * 0.3;
        const sp = (1.6 + Math.random() * 5.5) * SCALE;
        ps.push({
          x: cx,
          y: cy,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp - LIFT,
          life: 1,
          size: (2 + Math.random() * 3.5) * SCALE,
          color: colors[i % colors.length] || '#888',
          spin: (Math.random() - 0.5) * 0.5,
          rot: Math.random() * Math.PI,
        });
      }
      // 重复点击只是把上一波换掉，不会多开循环
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    };

    card.addEventListener('click', burst);
  }
</script>
