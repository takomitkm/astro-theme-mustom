---
// 分类索引 —— 对应 @vuepress/plugin-blog frontmatters 的 /category/ 页
import Base from '../../layouts/Base.astro';
import Cloud from '../../components/Cloud.astro';
import { getPosts, nameMap, maxCount } from '../../lib/posts';
import { site } from '../../config';

const posts = await getPosts();
const entries = nameMap(posts, 'categories');
const withEn = site.languages.includes('en-US');
---

<Base title={withEn ? 'Categories' : '分类'}>
  <Cloud mode="categories" entries={entries} total={posts.length} max={maxCount(entries)} />
</Base>
