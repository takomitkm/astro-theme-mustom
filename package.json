{
  "name": "mustom-astro",
  "version": "1.0.0",
  "description": "Mustom theme rewritten for Astro — ported from hexo-theme-mustom & vuepress-theme-mustom by jinyaoMa",
  "type": "module",
  "license": "MIT",
  "author": "jinyaoMa (original theme) — Astro port by Mustom contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinyaoMa/vuepress-theme-mustom"
  },
  "keywords": [
    "astro",
    "blog-theme",
    "mustom"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/simple-icons": "^1.2.98",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.7.0",
    "astro-icon": "^1.2.0",
    "github-markdown-css": "^5.8.1",
    "katex": "^0.19.0",
    "medium-zoom": "^1.1.0",
    "pagefind": "^1.5.2",
    "pangu": "^10.4.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "sass": "^1.86.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3"
  }
}
